        }
      ],
      "self_ref": "#/texts/12",
      "text": "Organele locale de specialitate în domeniul învțământului:"
    },
    {
      "children": [],
      "content_layer": "body",
      "enumerated": true,
      "label": "list_item",
      "marker": "1)",
      "orig": "1) vor asigura buna organizare și desfáşurare a sesiunii de examen în conformitate cu prevederile documentelor normative în vigoare;",
      "parent": {
        "$ref": "#/groups/2"
      },
      "prov": [
