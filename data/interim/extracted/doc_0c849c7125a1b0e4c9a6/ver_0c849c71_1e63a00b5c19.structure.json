    {
      "children": [],
      "content_layer": "body",
      "label": "text",
      "orig": "Cu privire la punerea în aplicare a deciziei Consiliului de administrației nr.3/1 din 24.04.2026 ,Cu privire la aprobarea Planului de admitere în învățământul liceal pentru anul de studii 2026-2027\"",
      "parent": {
        "$ref": "#/body"
      },
      "prov": [
        {
          "bbox": {
