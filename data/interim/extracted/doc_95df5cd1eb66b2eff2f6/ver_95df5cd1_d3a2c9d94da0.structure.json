          },
          "charspan": [
            0,
            63
          ],
          "page_no": 1
        }
      ],
      "self_ref": "#/texts/7",
      "text": "Se obligă directorii instituțiilor de învățământ general să:"
    },
    {
      "children": [],
      "content_layer": "body",
      "enumerated": true,
      "label": "list_item",
      "marker": "2.",
      "orig": "2. Se obligă cadrele de conducere/didactice ale instituțiilor de învățământ general sā întreprindă acțiuni în vederea informării elevilor/copiilor/părinților /reprezentanților legali ai acestora, asociațiilor obşteşti, privind ilegalitatea și inadmisibilitatea inițierii oricăror colectări de bani.",
      "parent": {
        "$ref": "#/groups/0"
      },
      "prov": [
        {
          "bbox": {
            "b": 149.22310333333337,
            "coord_origin": "BOTTOMLEFT",
