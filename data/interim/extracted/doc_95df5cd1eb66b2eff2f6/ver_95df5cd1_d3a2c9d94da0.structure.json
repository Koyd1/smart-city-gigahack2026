      "self_ref": "#/texts/5",
      "text": "ORDON:"
    },
    {
      "children": [],
      "content_layer": "body",
      "enumerated": true,
      "label": "list_item",
      "marker": "1.",
      "orig": "1. Se interzice cadrelor de conducere/didactice din instituțiile de învățământ general colectarea ilicită de bani sub orice pretext sau acceptarea altor beneficii din partea elevilor, părinților și a asociațiilor obștești părintești.",
      "parent": {
        "$ref": "#/groups/0"
      },
      "prov": [
        {
          "bbox": {
            "b": 218.88977,
            "coord_origin": "BOTTOMLEFT",
            "l": 44.0,
            "r": 520.3333333333333,
            "t": 272.22310333333337
          },
          "charspan": [
            0,
            233
          ],
          "page_no": 1
        }
      ],
      "self_ref": "#/texts/6",
      "text": "Se interzice cadrelor de conducere/didactice din instituțiile de învățământ general colectarea ilicită de bani sub orice pretext sau acceptarea altor beneficii din partea elevilor, părinților și a asociațiilor obștești părintești."
    },
    {
      "children": [],
      "content_layer": "body",
      "enumerated": true,
      "label": "list_item",
      "marker": "3.",
      "orig": "3. Se obligă directorii instituțiilor de învățământ general să:",
      "parent": {
        "$ref": "#/groups/0"
      },
      "prov": [
        {
          "bbox": {
            "b": 131.55643666666663,
            "coord_origin": "BOTTOMLEFT",
            "l": 60.66666666666667,
            "r": 415.0,
