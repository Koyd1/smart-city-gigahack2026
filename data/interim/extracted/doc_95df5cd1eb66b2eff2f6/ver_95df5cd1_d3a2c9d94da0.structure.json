    {
      "children": [],
      "content_layer": "body",
      "label": "text",
      "orig": "Cu privire la interzicerea colectărilor ilicite de bani in instituțiile de invățământ general",
      "parent": {
        "$ref": "#/body"
      },
      "prov": [
        {
          "bbox": {
            "b": 528.2231033333333,
            "coord_origin": "BOTTOMLEFT",
