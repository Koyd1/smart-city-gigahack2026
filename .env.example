# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/civis
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@localhost:5432/civis

# Redis
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_URL=redis://:replace-with-a-strong-password@127.0.0.1:6379/0

# OpenAI
OPENAI_API_KEY=sk-proj-replace
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=3072
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_FALLBACK_MODELS=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini

# RAG
RAG_TOP_K=5
RAG_SIM_THRESHOLD=0.2
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_RETRIEVER_PROBES=20
RAG_RETRIEVER_EXACT_SCAN_MAX_CHUNKS=1000

# Ingest
INGEST_TMP_DIR=/tmp/rag
INGEST_MAX_FILE_SIZE_MB=15
INGEST_IMAGE_MAX_FILE_SIZE_MB=5
INGEST_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp

# App URLs
NEXTAUTH_URL=http://127.0.0.1:3000
WEB_ORIGIN=http://127.0.0.1:3000
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Authentication
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@civis.local
ADMIN_PASSWORD=replace-with-a-strong-password

# Usage controls
DAILY_AI_BUDGET_USD=5
MONTHLY_AI_BUDGET_USD=100
MAX_CHAT_INPUT_TOKENS=12000

# Health and logs
HEALTH_OPENAI_WARN_MS=1800
HEALTH_HALL_WARN_THRESHOLD=0.45
HEALTH_CACHE_SECONDS=120
LOG_LEVEL=INFO
LOG_JSON=false
LOG_TO_FILE=false
LOG_FILE_PATH=logs/backend.log

# Production
APP_DOMAIN=localhost
